++                   "Windows; use input=bars, ramp, grid, black or none");
++        return;
++    }
++#else
++    if (s->input_pipe) {
++        size_t vbytes = (size_t)TS_VIDEO_IN_DWORDS * TS_VIDEO_LINES * 4;
++
++        s->in_front = g_malloc0(vbytes);
++        s->in_back = g_malloc0(vbytes);
++        s->in_stage = g_malloc0(vbytes);
