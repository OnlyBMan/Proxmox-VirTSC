++    hwaddr base;
++    int row;
++
++    s->program_frame_valid = false;
++    s->program_pairs = 0;
++    if ((!s->program_display && !s->program_audio) || !s->agp_stride) {
++        return;
++    }
++    if (s->agp_count && index >= s->agp_count) {
++        return;
++    }
++    base = (hwaddr)s->agp_base + s->agp_offset +
++           (hwaddr)index * s->agp_stride;
