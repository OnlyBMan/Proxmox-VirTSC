++    if (s->program_display) {
++        for (row = 0; row < TS_VIDEO_LINES; row++) {
++            pci_dma_read(PCI_DEVICE(s),
++                         base + (hwaddr)row * TS_VIDEO_STRIDE,
++                         s->program_frame +
++                         (size_t)row * TS_VIDEO_ACTIVE * 4,
++                         TS_VIDEO_ACTIVE * 4);
