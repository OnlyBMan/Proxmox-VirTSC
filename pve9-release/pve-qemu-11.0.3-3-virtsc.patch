++static void ts_in_widen(int fd, int bytes)
++{
++#ifdef F_SETPIPE_SZ
++    /* Best effort: capped by /proc/sys/fs/pipe-max-size, and not fatal. */
++    if (fcntl(fd, F_SETPIPE_SZ, bytes) < 0) {
++        /* nothing to do - the default size still works, just with more
++         * round trips */
++    }
++#endif
++}
