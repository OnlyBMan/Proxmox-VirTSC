++        s->in_aring = g_malloc0(s->in_aring_cap);
++        s->in_audio_stage = g_malloc0(TS_AUDIO_SAMPLES * 4);
++        qemu_mutex_init(&s->in_lock);
++        s->in_stopping = false;
++        qemu_thread_create(&s->in_thread, "tsc-input", ts_input_open_thread, s,
++                           QEMU_THREAD_JOINABLE);
++        s->in_running = true;
++    }
++#endif
