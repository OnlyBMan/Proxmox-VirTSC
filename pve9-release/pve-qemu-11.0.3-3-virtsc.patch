++        s->program_frame_valid = true;
++    }
++
++    if (s->program_audio) {
++        uint8_t count_raw[4];
++        uint8_t samples[TS_AUDIO_SAMPLES * 4];
++        uint32_t pairs;
++
++        pci_dma_read(PCI_DEVICE(s), base + TS_AUDIO_COUNT_OFF,
++                     count_raw, sizeof(count_raw));
