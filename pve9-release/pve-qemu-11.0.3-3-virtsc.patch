++                        "frames=%" PRIu64 " audio_pairs=%u afd=%d",
++                        s->in_frames, live_pairs, s->in_afd);
++        }
++    }
++    src = live ? live : s->pattern;
++    if (!src) {
++        return;
++    }
++    if (s->agp_count && index >= s->agp_count) {
++        return;
++    }
++    base = (hwaddr)s->agp_base + s->agp_offset + (hwaddr)index * s->agp_stride;
++
++    /*
