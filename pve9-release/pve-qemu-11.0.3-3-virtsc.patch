++static void ts_frame_audio(ThunderstormState *s, const uint8_t *vb)
++{
++    uint32_t index = ldl_le_p(vb + TS_VB_INDEX);
++    uint32_t samples[TS_AUDIO_SAMPLES];
++    uint32_t count, pairs, peak = 0, i;
++    hwaddr base;
++    uint8_t raw[4];
