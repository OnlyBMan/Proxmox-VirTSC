diff --git a/www/manager6/qemu/ThunderstormEdit.js b/www/manager6/qemu/ThunderstormEdit.js
new file mode 100644
index 0000000..0598d76
--- /dev/null
+++ b/www/manager6/qemu/ThunderstormEdit.js
@@ -0,0 +1,201 @@
+Ext.define('PVE.qemu.ThunderstormInputPanel', {
+    extend: 'Proxmox.panel.InputPanel',
+    xtype: 'pveThunderstormInputPanel',
+
+    onGetValues: function(values) {
+	let options = {};
+	for (const key of [
+	    'version', 'input', 'audio', 'program-display', 'program-audio', 'display', 'display-rate',
+	    'stamp', 'timecode', 'tstamp', 'input-file', 'input-pipe', 'input-audio',
+	    'output', 'ts-input', 'ts-input-audio', 'ts-output', 'frame-log', 'vterm',
+	]) {
+	    let value = values[key];
+	    if (value !== undefined && value !== '' && value !== '__default__') {
+		options[key] = value;
+	    }
+	}
+	let properties = PVE.Parser.printPropertyString(options);
+	return { thunderstorm: properties ? `1,${properties}` : '1' };
+    },
+
+    items: [{
+	xtype: 'textfield',
+	name: 'ts-input',
+	fieldLabel: gettext('TS Input'),
+	emptyText: '/path/on/proxmox-host/input.ts or udp://...',
+	width: 440,
+    }, {
+	xtype: 'proxmoxcheckbox',
+	name: 'ts-input-audio',
+	checked: true,
+	fieldLabel: gettext('TS Input Audio'),
+    }, {
+	xtype: 'textfield',
+	name: 'ts-output',
+	fieldLabel: gettext('TS Output'),
+	emptyText: '/path/on/proxmox-host/output.ts or udp://...',
+	width: 440,
+    }, {
+	xtype: 'displayfield',
+	value: gettext('TS paths and URLs are opened on the Proxmox host. Restart the VM after changing them.'),
+	userCls: 'pmx-hint',
+    }, {
+	xtype: 'proxmoxKVComboBox',
+	name: 'input',
+	value: '__default__',
+	fieldLabel: gettext('Capture Video'),
+	comboItems: [
+	    ['__default__', gettext('Default') + ' (bars)'],
+	    ['bars', gettext('Colour Bars')],
+	    ['ramp', gettext('Ramp')],
+	    ['grid', gettext('Grid')],
+	    ['black', gettext('Black')],
+	    ['none', Proxmox.Utils.NoneText],
+	],
+    }, {
+	xtype: 'proxmoxKVComboBox',
+	name: 'audio',
+	value: '__default__',
+	fieldLabel: gettext('Capture Audio'),
+	comboItems: [
+	    ['__default__', gettext('Default') + ' (off)'],
+	    ['off', gettext('Off')],
+	    ['tone', gettext('Test Tone')],
+	    ['silence', gettext('Silence')],
+	],
+    }, {
+	xtype: 'proxmoxcheckbox',
+	name: 'program-display',
+	checked: true,
+	fieldLabel: gettext('Programme Display'),
+    }, {
+	xtype: 'proxmoxcheckbox',
+	name: 'program-audio',
+	checked: true,
+	fieldLabel: gettext('Programme Audio'),
+    }],
+
+    advancedItems: [{
+	xtype: 'textfield',
+	name: 'version',
+	fieldLabel: gettext('Card Version'),
+	emptyText: '0x011a0012',
+	regex: /^0[xX][0-9a-fA-F]{1,8}$/,
+	regexText: gettext('Enter a 32-bit hexadecimal value, such as 0x011a0012.'),
+    }, {
+	xtype: 'displayfield',
+	value: gettext('A version that differs from the guest firmware can trigger a reflash and reboot.'),
+	userCls: 'pmx-hint',
+    }, {
+	xtype: 'proxmoxcheckbox',
+	name: 'display',
+	checked: true,
+	fieldLabel: gettext('Legacy Display'),
+    }, {
+	xtype: 'proxmoxintegerfield',
+	name: 'display-rate',
+	fieldLabel: gettext('Display Rate') + ' (Hz)',
+	emptyText: '10',
+	minValue: 0,
+	maxValue: 60,
+    }, {
+	xtype: 'proxmoxKVComboBox',
+	name: 'stamp',
+	value: '__default__',
+	fieldLabel: gettext('Capture Timestamp'),
+	comboItems: [
+	    ['__default__', gettext('Default') + ' (host-ns)'],
+	    ['host-ns', 'Host nanoseconds'],
+	    ['host-us', 'Host microseconds'],
+	    ['host-s', 'Host seconds'],
+	    ['virtual-us', 'Virtual microseconds'],
+	    ['zero', 'Zero'],
+	],
+    }, {
+	xtype: 'proxmoxKVComboBox',
+	name: 'timecode',
+	value: '__default__',
+	fieldLabel: gettext('Timecode'),
+	comboItems: [
+	    ['__default__', gettext('Default') + ' (utc)'],
+	    ['utc', 'RTC time'],
+	    ['drop', 'Drop frame'],
+	    ['free', 'Free running'],
+	    ['off', gettext('Off')],
+	],
+    }, {
+	xtype: 'proxmoxKVComboBox',
+	name: 'tstamp',
+	value: '__default__',
+	fieldLabel: gettext('Frame Timestamp'),
+	comboItems: [
+	    ['__default__', gettext('Default') + ' (off)'],
+	    ['off', gettext('Off')],
+	    ['host-ms', 'Host milliseconds'],
+	    ['host-us', 'Host microseconds'],
+	    ['host-s', 'Host seconds'],
+	],
+    }, {
+	xtype: 'displayfield',
+	value: gettext('Host file and FIFO paths below require root. Paths must be absolute.'),
+	userCls: 'pmx-hint',
+    }, {
+	xtype: 'textfield',
+	name: 'input-file',
+	fieldLabel: gettext('Input Frame File'),
+	emptyText: '/path/on/proxmox-host',
+    }, {
+	xtype: 'textfield',
+	name: 'input-pipe',
+	fieldLabel: gettext('Input Video FIFO'),
+	emptyText: '/path/on/proxmox-host',
+    }, {
+	xtype: 'textfield',
+	name: 'input-audio',
+	fieldLabel: gettext('Input Audio FIFO'),
+	emptyText: '/path/on/proxmox-host',
+    }, {
+	xtype: 'textfield',
+	name: 'output',
+	fieldLabel: gettext('Output FIFO'),
+	emptyText: '/path/on/proxmox-host',
+    }, {
+	xtype: 'textfield',
+	name: 'frame-log',
+	fieldLabel: gettext('Frame Log CSV'),
+	emptyText: '/path/on/proxmox-host',
+    }, {
+	xtype: 'textfield',
+	name: 'vterm',
+	fieldLabel: gettext('Debug Chardev ID'),
+    }],
+});
+
+Ext.define('PVE.qemu.ThunderstormEdit', {
+    extend: 'Proxmox.window.Edit',
+    subject: gettext('Thunderstorm Card'),
+    width: 500,
+    items: [{ xtype: 'pveThunderstormInputPanel' }],
+
+    initComponent: function() {
+	let me = this;
+	me.callParent();
+
+	if (!me.isCreate) {
+	    me.load({
+		success: function(response) {
+		    let value = response.result.data.thunderstorm;
+	    if (value) {
+		let options = PVE.Parser.parsePropertyString(value, 'enabled');
+		for (const key of ['program-display', 'program-audio', 'display', 'ts-input-audio']) {
+		    if (options[key] !== undefined) {
+			options[key] = options[key] === 'on' || options[key] === '1' || options[key] === true ? 1 : 0;
+		    }
+		}
+		me.setValues(options);
+		    }
+		},
+	    });
+	}
+    },
+});
